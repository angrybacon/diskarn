{
  "engines": {
    "node": "24.22.1"
  },
  "name": "diskarn",
  "packageManager": "pnpm@11.27.0",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "database:push": "dotenvx run --convention=nextjs -- drizzle-kit push",
    "dev": "dotenvx run --convention=nextjs -- tsx watch src/index.ts",
    "lint": "pnpm run '/^lint:[^:]+$/'",
    "lint:code": "oxlint",
    "lint:format": "prettier --check --log-level warn src/",
    "lint:prune": "DATABASE_URL=1 knip",
    "lint:typings": "tsc",
    "start": "dotenvx run --convention=nextjs -- tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch"
  },
  "dependencies": {
    "@discordeno/bot": "21.0.0",
    "@dotenvx/dotenvx": "2.38.2",
    "@fastify/type-provider-json-schema-to-ts": "5.0.1",
    "chalk": "6.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "node-schedule": "2.1.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "xml-js": "1.6.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@korumite/ts": "1.7.0",
    "@types/node": "26.6.5",
    "@types/node-schedule": "2.1.8",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "knip": "6.42.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
